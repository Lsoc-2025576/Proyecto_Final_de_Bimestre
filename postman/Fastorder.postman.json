              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente.demo@fastorder.com\",\n  \"password\": \"Cliente123*\"\n}"
            }
          }
        },
        {
          "name": "8. Login con el cliente recien registrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function decodificar(t) {",
                  "  let b = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (b.length % 4) { b += '='; }",
                  "  return JSON.parse(atob(b));",
                  "}",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un token JWT (3 partes)', () => pm.expect(json.token).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
                  "pm.test('Rol en la respuesta = CLIENTE', () => pm.expect(json.rol).to.eql('CLIENTE'));",
                  "pm.test('Claims del token correctos (sub, rol, userId)', () => {",
                  "  const p = decodificar(json.token);",
                  "  pm.expect(p.sub).to.eql(pm.collectionVariables.get('nuevoEmail'));",
                  "  pm.expect(p.rol).to.eql('CLIENTE');",
                  "  pm.expect(p.userId).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('clienteNuevoToken', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [

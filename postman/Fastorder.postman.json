              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('No entrega token', () => pm.expect(pm.response.json()).to.not.have.property('token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
